{
  "name": "shaar-hayichud-data-tools",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "build-data": "yarn compile && node build/cli/build.js",
    "test": "yarn compile && node --test \"build/**/*.test.js\"",
    "check-urls": "yarn compile && node build/cli/check-urls.js",
    "set-durations": "yarn compile && node build/cli/set-durations.js",
    "assign-line-ids": "yarn compile && node build/cli/assign-line-ids.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "typescript": "~5.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
