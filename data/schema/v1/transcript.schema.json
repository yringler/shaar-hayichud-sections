{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.shaarhayichudresources.com/data/v1/schema/transcript.schema.json",
  "title": "Lecture transcript (v1, RESERVED)",
  "description": "PLACEHOLDER — shape reserved, no files published yet. One file per lecture (/data/v1/transcripts/<url-encoded lecture id>.json). Fields may still be added before first use; existing fields will not change meaning within v1.",
  "x-status": "reserved",
  "type": "object",
  "required": ["schemaVersion", "lectureId", "language", "segments"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "lectureId": { "description": "Catalog lecture id.", "type": "string", "minLength": 1 },
    "language": { "description": "BCP 47 language tag, e.g. 'en'.", "type": "string", "minLength": 2 },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["startSeconds", "endSeconds", "text"],
        "properties": {
          "startSeconds": { "type": "number", "minimum": 0 },
          "endSeconds": { "type": "number", "minimum": 0 },
          "text": { "type": "string" },
          "speaker": { "type": "string" }
        }
      }
    }
  }
}
