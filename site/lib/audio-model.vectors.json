{
  "$comment": "Shared test vectors for the follow-along logic. Run by site/lib/audio-model.test.mjs against hugo/assets/js/audio/model.ts and by packages/dart/test/follow_along_test.dart against lib/src/follow_along.dart, so the site and the apps choose the same class and highlight the same line. Add a case here (not only in one test) when that logic changes.",
  "rankRefs": [
    {
      "name": "no preference: confidence first",
      "series": ["0", "0", "37"],
      "refs": [[0, 10, 0.8], [2, 50, 0.99], [1, 3, 0.9]],
      "pref": { "seriesId": null, "currentLecture": null },
      "expect": [[2, 50], [1, 3], [0, 10]]
    },
    {
      "name": "selected series wins",
      "series": ["0", "0", "37"],
      "refs": [[0, 10, 0.8], [2, 50, 0.99], [1, 3, 0.9]],
      "pref": { "seriesId": "0", "currentLecture": null },
      "expect": [[1, 3], [0, 10], [2, 50]]
    },
    {
      "name": "within the series, the class in the player wins",
      "series": ["0", "0", "37"],
      "refs": [[0, 10, 0.8], [2, 50, 0.99], [1, 3, 0.9]],
      "pref": { "seriesId": "0", "currentLecture": 0 },
      "expect": [[0, 10], [1, 3], [2, 50]]
    },
    {
      "name": "series before the class in the player",
      "series": ["0", "0", "37"],
      "refs": [[0, 10, 0.8], [2, 50, 0.99], [1, 3, 0.9]],
      "pref": { "seriesId": "37", "currentLecture": 0 },
      "expect": [[2, 50], [0, 10], [1, 3]]
    },
    {
      "name": "selected series does not cover the line: the others",
      "series": ["0", "0", "37"],
      "refs": [[0, 10, 0.8], [2, 50, 0.99], [1, 3, 0.9]],
      "pref": { "seriesId": "99", "currentLecture": null },
      "expect": [[2, 50], [1, 3], [0, 10]]
    },
    {
      "name": "equal confidence: catalog order, then time",
      "series": ["0", "0", "37"],
      "refs": [[1, 3, 0.9], [0, 9, 0.9], [0, 2, 0.9]],
      "pref": { "seriesId": null, "currentLecture": null },
      "expect": [[0, 2], [0, 9], [1, 3]]
    }
  ],
  "spans": [
    {
      "name": "current until the next line starts, held at most 30 s past its end",
      "items": [["x", 10, 20], ["y", 25, 30], ["z", 100, 110]],
      "expect": [[10, 25, ["x"]], [25, 60, ["y"]], [100, 140, ["z"]]],
      "at": [[9.9, null], [10, ["x"]], [24.9, ["x"]], [25, ["y"]], [70, null], [139, ["z"]], [140, null]]
    },
    {
      "name": "zero-length and same-start lines (collapsed timestamps) still get a span",
      "items": [["a", 1207, 1207], ["b", 1207, 1211.2], ["c", 1271.7, 1271.7], ["d", 1323.3, 1323.3]],
      "expect": [[1207, 1241.2, ["a", "b"]], [1271.7, 1301.7, ["c"]], [1323.3, 1353.3, ["d"]]],
      "at": [[1271.7, ["c"]]]
    },
    {
      "name": "same-start lines keep their input order, whatever order the rest come in",
      "items": [["late", 50, 55], ["p", 5, 6], ["q", 5, 9], ["r", 5, 5]],
      "expect": [[5, 39, ["p", "q", "r"]], [50, 85, ["late"]]],
      "at": [[4.9, null], [5, ["p", "q", "r"]], [39, null], [50, ["late"]]]
    },
    {
      "name": "an overlapping range is cut at the next line's start",
      "items": [["long", 0, 300], ["next", 100, 110]],
      "expect": [[0, 100, ["long"]], [100, 140, ["next"]]],
      "at": [[120, ["next"]], [50, ["long"]]]
    },
    {
      "name": "a custom hold",
      "hold": 5,
      "items": [["x", 0, 10], ["y", 100, 100]],
      "expect": [[0, 15, ["x"]], [100, 105, ["y"]]],
      "at": [[14.9, ["x"]], [15, null], [104, ["y"]]]
    },
    {
      "name": "no items",
      "items": [],
      "expect": [],
      "at": [[0, null]]
    }
  ],
  "nextInSeries": [
    { "series": ["0", "0", "37"], "lecture": 0, "expect": 1 },
    { "series": ["0", "0", "37"], "lecture": 1, "expect": null },
    { "series": ["0", "0", "37"], "lecture": 2, "expect": null },
    { "series": ["0", "37", "0", "37"], "lecture": 0, "expect": 2 },
    { "series": ["0", "37", "0", "37"], "lecture": 1, "expect": 3 },
    { "series": ["0", "37", "0", "37"], "lecture": 3, "expect": null },
    { "series": ["0", "37", "0", "37"], "lecture": 9, "expect": null }
  ],
  "chooseSeries": [
    { "name": "the saved teacher", "here": ["0", "37"], "saved": "37", "expect": { "series": "37", "fellBack": false } },
    { "name": "nothing saved: the default teacher, even listed second", "here": ["37", "0"], "saved": null, "expect": { "series": "0", "fellBack": false } },
    { "name": "saved teacher absent: the default, flagged", "here": ["37", "0"], "saved": "5", "expect": { "series": "0", "fellBack": true } },
    { "name": "neither saved nor default here: the first", "here": ["37", "5"], "saved": null, "expect": { "series": "37", "fellBack": false } },
    { "name": "no series", "here": [], "saved": null, "expect": { "series": null, "fellBack": false } }
  ],
  "topicAt": [
    { "topics": [10, 60], "t": 5, "expect": null },
    { "topics": [10, 60], "t": 10, "expect": 0 },
    { "topics": [10, 60], "t": 59, "expect": 0 },
    { "topics": [10, 60], "t": 600, "expect": 1 },
    { "topics": [], "t": 5, "expect": null }
  ],
  "playableRefs": [
    {
      "name": "no class chosen: every class, ranked",
      "series": ["0", "0", "37"],
      "refs": [[0, 10, 0.8], [2, 50, 0.99], [1, 3, 0.9]],
      "pref": { "seriesId": "0", "currentLecture": null },
      "selected": null,
      "expect": [[1, 3], [0, 10], [2, 50]]
    },
    {
      "name": "a class chosen: only its ranges, even over the preferred teacher",
      "series": ["0", "0", "37"],
      "refs": [[0, 10, 0.8], [2, 50, 0.99], [1, 3, 0.9]],
      "pref": { "seriesId": "0", "currentLecture": 2 },
      "selected": 2,
      "expect": [[2, 50]]
    },
    {
      "name": "the chosen class does not read the line: every class, ranked",
      "series": ["0", "0", "37"],
      "refs": [[0, 10, 0.8], [1, 3, 0.9]],
      "pref": { "seriesId": "0", "currentLecture": 2 },
      "selected": 2,
      "expect": [[1, 3], [0, 10]]
    },
    {
      "name": "the chosen class reads the line: it wins over the preferred teacher",
      "series": ["0", "0", "37"],
      "refs": [[0, 10, 0.99], [2, 50, 0.5]],
      "pref": { "seriesId": "0", "currentLecture": 2 },
      "selected": 2,
      "expect": [[2, 50]]
    },
    {
      "name": "the chosen class reads the line twice: higher confidence, then earlier",
      "series": ["0", "0"],
      "refs": [[1, 90, 0.7], [0, 5, 0.9], [1, 20, 0.7], [1, 40, 0.95]],
      "pref": { "seriesId": null, "currentLecture": 1 },
      "selected": 1,
      "expect": [[1, 40], [1, 20], [1, 90]]
    }
  ],
  "playStart": [
    {
      "name": "the class's first line after a long intro: play the line, offer the start",
      "chapterStarts": [0],
      "lines": [[[0, 63.8]], [[0, 108.7]]],
      "ref": [0, 63.8],
      "expect": [63.8, 0]
    },
    {
      "name": "a short lead-in is played, nothing offered",
      "chapterStarts": [0],
      "lines": [[[0, 12.9]]],
      "ref": [0, 12.9],
      "expect": [0, null]
    },
    {
      "name": "a lead-in of exactly the threshold is offered",
      "chapterStarts": [0],
      "lines": [[[0, 15]]],
      "ref": [0, 15],
      "expect": [15, 0]
    },
    {
      "name": "any later line plays from itself",
      "chapterStarts": [0],
      "lines": [[[0, 63.8]], [[0, 108.7]]],
      "ref": [0, 108.7],
      "expect": [108.7, null]
    },
    {
      "name": "a later chapter of a two-chapter class: the hand-off just before the first line is played",
      "chapterStarts": [1267.75],
      "lines": [[[0, 1270.75]], [[0, 1300]]],
      "ref": [0, 1270.75],
      "expect": [1267.75, null]
    },
    {
      "name": "a later chapter with a hand-set start well before its first line: offered",
      "chapterStarts": [872],
      "lines": [[[0, 892.5]]],
      "ref": [0, 892.5],
      "expect": [892.5, 872]
    },
    {
      "name": "the part starts at the first line itself: nothing to offer",
      "chapterStarts": [919.28],
      "lines": [[[0, 919.28]]],
      "ref": [0, 919.28],
      "expect": [919.28, null]
    },
    {
      "name": "only the class's own refs count: another class reading earlier does not",
      "chapterStarts": [0, 0],
      "lines": [[[1, 5]], [[0, 64], [1, 40]]],
      "ref": [0, 64],
      "expect": [64, 0]
    },
    {
      "name": "the class reads an earlier line here: no offer on this one",
      "chapterStarts": [0],
      "lines": [[[0, 300]], [[0, 64]]],
      "ref": [0, 300],
      "expect": [300, null]
    },
    {
      "name": "a file without chapterStartSeconds: the line, nothing offered",
      "chapterStarts": [null],
      "lines": [[[0, 63.8]]],
      "ref": [0, 63.8],
      "expect": [63.8, null]
    }
  ],
  "lineInClass": [
    { "refs": [0, 2], "selected": null, "expect": true },
    { "refs": [0, 2], "selected": 2, "expect": true },
    { "refs": [0, 2], "selected": 1, "expect": false },
    { "refs": [], "selected": null, "expect": true },
    { "refs": [], "selected": 0, "expect": false }
  ]
}
